<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET 8 reached end of support on 10 Nov 2026; .NET 10 is the current LTS. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ClockScreensaver</AssemblyName>
    <RootNamespace>ClockScreensaver</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      Framework-dependent single file, NOT self-contained, NOT compressed.
      The old build was a ~30 MB self-contained, compressed bundle that unpacked native
      code to %TEMP% at start-up. Unsigned, rarely-seen executables that unpack or
      decompress themselves are a classic trigger for Microsoft Defender's heuristic
      ("Wacatac"-style) false positives. This build is a small ordinary .NET executable
      that runs on the Microsoft-signed .NET Desktop Runtime installed on the PC.
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <!-- Run on a newer .NET major version if 10 isn't installed. -->
    <RollForward>Major</RollForward>

    <!--
      Version: overridden by the release workflow from the git tag (-p:Version=0.3.0).
      AssemblyVersion and FileVersion are derived from it by the SDK.
    -->
    <Version>0.3.0-dev</Version>

    <!-- File properties shown in Explorer; unsigned files with no metadata look more suspicious. -->
    <Product>Clock Screensaver</Product>
    <AssemblyTitle>Clock Screensaver</AssemblyTitle>
    <Description>Clock screensaver with weather and ambient effects</Description>
    <Company>Dima Kanevsky</Company>
    <Authors>Dima Kanevsky</Authors>
    <Copyright>Copyright (c) 2026 Dima Kanevsky. MIT License.</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="fonts\*.ttf" />
    <EmbeddedResource Include="fonts\*.txt" />
  </ItemGroup>

  <!-- Stamp the build with the current git commit so installed builds can be told apart. -->
  <Target Name="WriteBuildInfo" BeforeTargets="BeforeCompile;CoreCompile">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" ContinueOnError="true" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" ItemName="GitHashOutput" />
    </Exec>
    <PropertyGroup>
      <GitHash Condition="'@(GitHashOutput)' != ''">@(GitHashOutput)</GitHash>
      <GitHash Condition="'$(GitHash)' == ''">unknown</GitHash>
      <BuildTimestamp>$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd HH:mm"))</BuildTimestamp>
    </PropertyGroup>
    <ItemGroup>
      <BuildInfoLines Include="namespace ClockScreensaver%3B" />
      <BuildInfoLines Include="internal static class BuildInfo" />
      <BuildInfoLines Include="{" />
      <BuildInfoLines Include="    public const string Version = &quot;$(Version)&quot;%3B" />
      <BuildInfoLines Include="    public const string GitHash = &quot;$(GitHash)&quot;%3B" />
      <BuildInfoLines Include="    public const string BuiltAt = &quot;$(BuildTimestamp) UTC&quot;%3B" />
      <BuildInfoLines Include="}" />
    </ItemGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" Condition="!Exists('$(IntermediateOutputPath)')" />
    <WriteLinesToFile File="$(IntermediateOutputPath)BuildInfo.g.cs" Overwrite="true" Lines="@(BuildInfoLines)" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildInfo.g.cs" />
    </ItemGroup>
  </Target>

</Project>
